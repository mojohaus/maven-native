<project>

  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.codehaus.mojo.natives.it</groupId>
    <artifactId>it-parent</artifactId>
    <version>1.0-SNAPSHOT</version>
  </parent>

  <groupId>org.codehaus.mojo.natives.it.jni</groupId>
  <artifactId>jni-windows</artifactId>
  <version>1.0-SNAPSHOT</version>
  <name>JNI Example - Windows</name>

  <packaging>pom</packaging>

  <description>Builds the Java class and its hello.dll, then runs the test that loads the library</description>

