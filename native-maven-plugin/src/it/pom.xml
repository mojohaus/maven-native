<project>

  <modelVersion>4.0.0</modelVersion>

  <groupId>org.codehaus.mojo.natives.it</groupId>
  <artifactId>it-parent</artifactId>
  <version>1.0-SNAPSHOT</version>
  <name>Maven Native Plugin IT Parent</name>

  <packaging>pom</packaging>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <scope>test</scope>
      <version>5.14.4</version>
    </dependency>
  </dependencies>


  <properties>
    <maven.compiler.release>11</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- native.plugin.version, the version of the plugin under test, is passed in by the invoker execution -->
  </properties>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>native-maven-plugin</artifactId>
          <version>${native.plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.16.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.6.1</version>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>build-helper-maven-plugin</artifactId>
          <version>3.0.0</version>
        </plugin>

        <plugin>
          <groupId>org.eclipse.m2e</groupId>
          <artifactId>lifecycle-mapping</artifactId>
          <version>1.0.0</version>
          <configuration>
            <lifecycleMappingMetadata>
              <pluginExecutions>
                <pluginExecution>
                  <pluginExecutionFilter>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>native-maven-plugin</artifactId>
                    <versionRange>[0,)</versionRange>
                    <goals>
                      <goal>initialize</goal>
                      <goal>javah</goal>
                      <goal>unzipinc</goal>
                      <goal>manifest</goal>
                      <goal>compile</goal>
                      <goal>resource-compile</goal>
                      <goal>link</goal>
                    </goals>
                  </pluginExecutionFilter>
                  <action>
                    <execute>
                      <runOnIncremental>false</runOnIncremental>
                    </execute>
                    <!-->ignore></ignore -->
                  </action>
                </pluginExecution>
              </pluginExecutions>
            </lifecycleMappingMetadata>
          </configuration>
        </plugin>


      </plugins>
    </pluginManagement>
  </build>

  <profiles>
    <profile>
      <id>msvc-2022</id>
      <activation>
        <property>
          <name>env.VS170COMNTOOLS</name>
        </property>
      </activation>
      <properties>
        <msvc.env.factory>org.codehaus.mojo.natives.msvc.MSVC2022x64EnvFactory</msvc.env.factory>
      </properties>
    </profile>
    <profile>
      <id>msvc-2019</id>
      <activation>
        <property>
          <name>env.VS160COMNTOOLS</name>
        </property>
      </activation>
      <properties>
        <msvc.env.factory>org.codehaus.mojo.natives.msvc.MSVC2019x64EnvFactory</msvc.env.factory>
      </properties>
    </profile>
    <profile>
      <id>msvc-2013</id>
      <activation>
        <property>
          <name>env.VS120COMNTOOLS</name>
        </property>
      </activation>
      <properties>
        <msvc.env.factory>org.codehaus.mojo.natives.msvc.MSVC2013x86AMD64EnvFactory</msvc.env.factory>
      </properties>
    </profile>
    <profile>
      <id>msvc-2012</id>
      <activation>
        <property>
          <name>env.VS110COMNTOOLS</name>
        </property>
      </activation>
      <properties>
        <msvc.env.factory>org.codehaus.mojo.natives.msvc.MSVC2012x86AMD64EnvFactory</msvc.env.factory>
      </properties>
    </profile>
    <profile>
      <id>msvc-2010</id>
      <activation>
        <property>
          <name>env.VS100COMNTOOLS</name>
        </property>
      </activation>
      <properties>
        <msvc.env.factory>org.codehaus.mojo.natives.msvc.MSVC2010x86AMD64EnvFactory</msvc.env.factory>
      </properties>
    </profile>
    <profile>
      <id>msvc-2008</id>
      <activation>
        <property>
          <name>env.VS90COMNTOOLS</name>
        </property>
      </activation>
      <properties>
        <msvc.env.factory>org.codehaus.mojo.natives.msvc.MSVC2008x86AMD64EnvFactory</msvc.env.factory>
      </properties>
    </profile>


  </profiles>

</project>
